#include <stdio.h>

int main() {
    int n, i;
    
    printf("Enter the number of students: ");
    scanf("%d", &n);

    int attendance[n]; 

    for(i = 0; i < n; i++) {
        printf("Enter attendance number for student %d: ", i + 1);
        scanf("%d", &attendance[i]);
    }

    printf("\nAttendance numbers of students are:\n");
    for(i = 0; i < n; i++) {
        printf("Student %d: %d\n", i + 1, attendance[i]);
    }

    return 0;
}
