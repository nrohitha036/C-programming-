#include <stdio.h>

struct Product {
    int id;
    char name[20];
    float price;
};

int main() {
    struct Product p;

    printf("Enter Product ID, Name, Price: ");
    scanf("%d %s %f", &p.id, p.name, &p.price);

    printf("\nProduct Details:\nID: %d\nName: %s\nPrice: %.2f\n", p.id, p.name, p.price);
    return 0;
}
