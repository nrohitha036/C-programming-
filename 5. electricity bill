#include <stdio.h>

int main() {
    int u;
    float bill;

    printf("Enter units consumed: ");
    scanf("%d", &u);

    if(u <= 100)
        bill = u * 1;
    else if(u <= 200)
        bill = 100 * 1 + (u - 100) * 2;
    else
        bill = 100 * 1 + 100 * 2 + (u - 200) * 3;

    printf("Electricity Bill = %.2f\n", bill);
    return 0;
}
