#include <stdio.h>

struct Employee { int id; char name[20]; float salary; };

int main() {
    struct Employee e;
    FILE *f = fopen("employee.txt", "r");
    if(f == NULL) { printf("File not found\n"); return 1; }

    fscanf(f, "%d %s %f", &e.id, e.name, &e.salary);
    printf("ID: %d\nName: %s\nSalary: %.2f\n", e.id, e.name, e.salary);

    fclose(f);
    return 0;
}
