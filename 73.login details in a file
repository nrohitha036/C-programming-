#include <stdio.h>

struct Login { char username[20]; char password[20]; };

int main() {
    struct Login l;
    FILE *f = fopen("login.txt", "w");
    if(f == NULL) { printf("Cannot open file\n"); return 1; }

    printf("Enter username and password: ");
    scanf("%s %s", l.username, l.password);

    fprintf(f, "%s %s\n", l.username, l.password);
    fclose(f);

    printf("Login details saved.\n");
    return 0;
}
