#include <stdio.h>

int main() {
    FILE *f = fopen("data.txt", "a");
    char name[20];
    int id;

    if(f == NULL) { printf("Cannot open file\n"); return 1; }

    printf("Enter ID and Name to append: ");
    scanf("%d %s", &id, name);

    fprintf(f, "%d %s\n", id, name);
    fclose(f);

    printf("Data appended successfully.\n");
    return 0;
}
