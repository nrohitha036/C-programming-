#include <stdio.h>
#include <string.h>

int validate(char u[], char p[]) { return strcmp(u,"admin")==0 && strcmp(p,"1234")==0; }

int main() {
    char user[20], pass[20];
    printf("Username: "); scanf("%s", user);
    printf("Password: "); scanf("%s", pass);
    printf(validate(user,pass) ? "Login Successful\n" : "Invalid Username or Password\n");
    return 0;
}
