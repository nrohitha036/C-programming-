#include <stdio.h>

int main() {
    int n;
    float sum = 0, m;

    printf("Enter number of subjects: ");
    scanf("%d", &n);

    for(int i = 1; i <= n; i++) {
        printf("Enter marks of subject %d: ", i);
        scanf("%f", &m);
        sum += m;
    }

    printf("Average marks = %.2f\n", sum / n);
    return 0;
}
