#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char p[50]; int i, d=0, u=0;
    printf("Enter password: ");
    scanf("%s", p);

    if(strlen(p)<6){ printf("Password too short!\n"); return 0; }

    for(i=0; p[i]; i++){ if(isdigit(p[i])) d=1; if(isupper(p[i])) u=1; }

    printf("%s\n", (d && u) ? "Password is valid." : "Password is invalid.");
    return 0;
}
