#include <stdio.h>
#include <string.h>

int main() {
    char mob[20];
    int i, valid = 1;

    printf("Enter mobile number: ");
    scanf("%s", mob);

    if (strlen(mob) != 10 || mob[0] < '6')
        valid = 0;

    for (i = 0; mob[i] != '\0'; i++) {
        if (mob[i] < '0' || mob[i] > '9')
            valid = 0;
    }

    if (valid)
        printf("Valid mobile number");
    else
        printf("Invalid mobile number");

    return 0;
}
